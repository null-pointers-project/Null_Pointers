# ============================================================
# Smart Story Teller - DEVICE CONFIGURATION
# Platform-aware settings for Mac (training) and Windows (deploy)
# ============================================================

# --- Model Paths (HuggingFace Hub) ---
HUGGINGFACE_USERNAME=your-username
HUGGINGFACE_TOKEN=your-hf-token

# Eğitim tamamlandıktan sonra buraya model repo adları yazılacak
CAPTIONING_MODEL_REPO=your-username/smart-story-teller-captioning
STORY_MODEL_REPO=your-username/smart-story-teller-gpt2

# --- Training Config (Mac) ---
DEVICE=mps                    # mps | cpu | cuda
BATCH_SIZE=32                 # M4 16GB için önerilen
CAPTION_EPOCHS=20
STORY_EPOCHS=3
LEARNING_RATE=0.0003

# --- Data Paths ---
COCO_DATA_DIR=./data/coco_subset
WRITING_PROMPTS_DIR=./data/writing_prompts
MODELS_DIR=./models

# --- Inference Config (Windows) ---
# HF_INFERENCE_API=true       # True: HF API kullan, False: local model
USE_LOCAL_MODEL=false         # Modeller Mac'te eğitildikten sonra değişecek
